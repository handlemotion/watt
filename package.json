{
  "name": "watt",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "protocol:check": "pnpm --filter @watt/desktop-sidecar protocol:check",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "format": "prettier --write \"**/*.{ts,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
