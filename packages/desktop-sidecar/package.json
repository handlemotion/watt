{
  "name": "@watt/desktop-sidecar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "watt-desktop-sidecar": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "protocol.schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "protocol:check": "node scripts/check-schema.mjs"
  },
  "dependencies": {
    "@watt/host": "workspace:*",
    "ajv": "^8.17.1",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@watt/typescript-config": "workspace:*",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
