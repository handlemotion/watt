{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "WebWorker"],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["src/auth.cli.ts"]
}
